spring:
  datasource:
    driver-class-name: com.p6spy.engine.spy.P6SpyDriver
    url: jdbc:p6spy:postgresql://localhost:5432/robot
    username: postgres
    password: your_db_password
    hikari:
      pool-name: AI-Robot-HikariCP
      auto-commit: true
      connection-timeout: 30000
      idle-timeout: 600000
      max-lifetime: 1800000
      minimum-idle: 5
      maximum-pool-size: 20
      connection-test-query: SELECT 1
      validation-timeout: 5000
  ai:
    openai:
      base-url: https://api.deepseek.com
      api-key: your_deepseek_api_key
      chat:
        options:
          model: deepseek-chat
      embedding:
        base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
        api-key: your_embedding_api_key
        model: text-embedding-v4
        dimensions: 1536
    vectorstore:
      pgvector:
        index-type: HNSW
        distance-type: COSINE_DISTANCE
        dimensions: 1536
        max-document-batch-size: 10000
        table-name: t_vector_store
  elasticsearch:
    uris: http://localhost:9200
    connection-timeout: 5s
    socket-timeout: 30s

okhttp:
  connect-timeout: 5000
  read-timeout: 30000
  write-timeout: 15000
  max-idle-connections: 200
  keep-alive-duration: 5

searxng:
  url: http://localhost:8888/search
  count: 10

customer-service:
  file-storage-path: ./data/files
  chunk-path: ./data/chunks
  model: deepseek-chat
  temperature: 0.0

rag:
  elasticsearch:
    enabled: true
    index-name: rag_chunk
  hybrid:
    enabled: true
    candidate-top-k: 20
    final-top-k: 5
    rrf-k: 60
  rerank:
    enabled: true
    model: qwen3-rerank
    api-url: https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
    api-key: your_rerank_api_key
    candidate-top-k: 20
    score-threshold: 0.0
    max-document-chars: 4000
    instruct: "Given a web search query, retrieve relevant passages that answer the query."
  agent:
    enabled: true
